# Set these as process environment variables. Spring does not automatically read this file.
DB_URL=jdbc:mysql://localhost:3306/erp?serverTimezone=UTC
DB_USERNAME=erp
DB_PASSWORD=replace-with-database-password
JWT_SECRET=replace-with-base64-encoded-32-random-bytes
CORS_ALLOWED_ORIGINS=http://localhost:5173
INITIAL_ADMIN_ENABLED=false
# First setup only: enable bootstrap and supply a new password of at least 12 characters.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_EMAIL=admin@example.com
DB_DDL_AUTO=validate
DB_BASELINE_ON_MIGRATE=false
