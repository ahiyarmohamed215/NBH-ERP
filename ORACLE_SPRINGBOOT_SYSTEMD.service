# ==============================================================================
# NBH ERP - Spring Boot Systemd Service Unit
# Target: Oracle Cloud Infrastructure (OCI) Always Free - VM.Standard.A1.Flex (ARM64)
# Sizing: 2 OCPUs, 12 GB RAM, Ubuntu 24.04 LTS
# Installation Path: /etc/systemd/system/nbh-erp.service
#
# Instructions:
# 1. Place this file at /etc/systemd/system/nbh-erp.service
# 2. Reload systemd daemon: sudo systemctl daemon-reload
# 3. Enable at boot: sudo systemctl enable nbh-erp.service
# 4. Start service: sudo systemctl start nbh-erp.service
# 5. Check status: sudo systemctl status nbh-erp.service
# 6. Stream logs: sudo journalctl -u nbh-erp.service -f
# ==============================================================================

[Unit]
Description=NBH ERP Spring Boot Application Backend
Documentation=https://example.com/erp
After=network.target mysql.service
Requires=mysql.service

[Service]
Type=simple
User=erp
Group=erp

# Working directory and execution paths
WorkingDirectory=/opt/erp
EnvironmentFile=/opt/erp/config/erp.env

# Execution Command with Architecture-Tuned JVM Parameters for 2 OCPUs & 12 GB RAM:
# - -Xms3g -Xmx4g: Sized for JVM heap (leaves 3.5GB for MySQL, 2GB for OS/NGINX, 1.5GB headroom)
# - -XX:MaxMetaspaceSize=384m: Bounds class metadata memory
# - -XX:+UseG1GC -XX:MaxGCPauseMillis=200: Low-pause concurrent garbage collector
# - -Djava.awt.headless=true: Crucial for server-side PDF and office/warehouse slip printing
# - -Duser.timezone=UTC -Dfile.encoding=UTF-8: Consistent timestamps and UTF-8 multi-language support
ExecStart=/usr/bin/java \
    -Xms3g \
    -Xmx4g \
    -XX:MaxMetaspaceSize=384m \
    -XX:+UseG1GC \
    -XX:MaxGCPauseMillis=200 \
    -XX:G1ReservePercent=15 \
    -Djava.awt.headless=true \
    -Duser.timezone=UTC \
    -Dfile.encoding=UTF-8 \
    -jar /opt/erp/nbh-erp.jar

# Process Management and Resilience
Restart=always
RestartSec=10s
TimeoutStartSec=120s
TimeoutStopSec=30s
SuccessExitStatus=143

# Resource Limits (File descriptors for SSE concurrent connections and DB pools)
LimitNOFILE=65536
LimitNPROC=4096

# Linux Kernel Sandboxing and Security Isolation
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
ReadWritePaths=/opt/erp /var/log/nbh-erp /tmp

# Unified Journal Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nbh-erp

[Install]
WantedBy=multi-user.target
