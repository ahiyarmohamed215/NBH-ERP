# Placeholder template only. Fill in a protected file OUTSIDE the checkout.
# Intended for systemd EnvironmentFile, not automatic Spring .env loading.
SPRING_PROFILES_ACTIVE=prod
RDS_HOST=<rds-dns-endpoint>
RDS_PORT=<mysql-port-usually-3306>
DB_NAME=<database-name-nbh_erp>
DB_USERNAME=<application-user-nbh_erp_app>
DB_PASSWORD=<rotated-application-password>
FLYWAY_USERNAME=<migration-user-nbh_erp_migrator>
FLYWAY_PASSWORD=<rotated-migration-password>
DB_SSL_TRUSTSTORE_URL=<file-url-to-rds-ca-pkcs12-truststore>
DB_SSL_TRUSTSTORE_PASSWORD=<truststore-password>
JWT_SECRET=<base64-key-containing-at-least-32-random-decoded-bytes>
CORS_ALLOWED_ORIGINS=<exact-public-https-origin-without-trailing-slash>

# Optional tuning; omit these entries to use the documented production defaults.
# HIKARI_MAX_POOL_SIZE=<maximum-runtime-connections-default-10>
# HIKARI_MIN_IDLE=<minimum-idle-runtime-connections-default-2>
# DB_SOCKET_TIMEOUT_MS=<socket-read-timeout-default-60000>
# APP_BUSINESS_TIMEZONE=<business-timezone-default-Asia/Colombo>
# JWT_ACCESS_TOKEN_EXPIRATION_MS=<access-lifetime-default-900000>
# JWT_REFRESH_TOKEN_EXPIRATION_MS=<refresh-lifetime-default-1800000>

# First initialization only: enable once, verify the account, then disable and
# remove the initial password. Default creation is disabled.
# INITIAL_ADMIN_ENABLED=<true-for-first-bootstrap-then-false>
# INITIAL_ADMIN_USERNAME=<bootstrap-admin-username>
# INITIAL_ADMIN_PASSWORD=<new-bootstrap-password-at-least-12-characters>
# INITIAL_ADMIN_EMAIL=<bootstrap-admin-email>
